        <mxCell id="RRyIs05DNhQXFqDyClG--21" value="&lt;h3 data-start=&quot;2070&quot; data-end=&quot;2093&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Principals of Interaction&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Client sends HTTP request to Router&lt;/li&gt;&lt;li&gt;Router redirects to specific service&lt;/li&gt;&lt;li&gt;Service implements business logic&lt;/li&gt;&lt;li&gt;Service uses Repository to process Data&lt;/li&gt;&lt;li&gt;Repository communicates with DB&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#6D1F00;fillColor=#a0522d;align=left;verticalAlign=middle;rounded=0;fontColor=#ffffff;" parent="1" vertex="1">
